# ==============================================================================
# EQ OS — Local Development Environment Configuration
# Copy this file to .env.local in your eq-os directory
# ==============================================================================

# 1. APPLICATION
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_32_char_secret_string

# 2. HOSTINGER MYSQL DATABASE
# Fill with the database details created in Hostinger hPanel > Databases
DATABASE_HOST=sql123.hostinger.com
DATABASE_PORT=3306
DATABASE_NAME=u123456789_eqos
DATABASE_USER=u123456789_eqos_user
DATABASE_PASSWORD=your_database_password_here

# 3. AI COMPANION (Anthropic Claude API)
# Get your API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# 4. EMAIL / MAGIC LINK (Hostinger / Zoho Mail SMTP)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=learn@drishtavidya.com
SMTP_PASSWORD=your_zoho_app_password
SMTP_FROM="Drishta Vidya EQ OS <learn@drishtavidya.com>"
