# ==============================================================================
# EQ OS — Production Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Base URL of your Subdomain (e.g. https://app.drishtavidya.com or https://eqos.drishtavidya.com)
NEXT_PUBLIC_APP_URL=https://app.drishtavidya.com

# Hostinger MySQL Database Credentials (from Hostinger hPanel > Databases > MySQL Databases)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=u123456789_eqos
DATABASE_USER=u123456789_eqos_user
DATABASE_PASSWORD=your_strong_mysql_password
DATABASE_SSL=false

# Admin Studio Passcode
ADMIN_PASSWORD=your_custom_admin_passcode
